# World TV - Environment Configuration

# Server
NODE_ENV=production
PORT=8080

# Database
DATABASE_URL=sqlite:///app/data/worldtv.sqlite

# Redis (for caching)
REDIS_URL=redis://localhost:6379

# RapidAPI Football
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=api-football-v1.p.rapidapi.com

# OpenAI (for AI image generation)
OPENAI_API_KEY=sk-your_openai_key_here

# Cloudinary (for image storage)
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=https://api.cloudinary.com/v1_1/your_cloud_name

# Optional: Payment Integration
PAYSTACK_PUBLIC_KEY=pk_live_your_key
PAYSTACK_SECRET_KEY=sk_live_your_key

# Optional: Email Configuration
EMAIL_SERVICE=your_service
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_password

# Application Settings
APP_NAME=World TV
APP_URL=https://www.myworldtvlive.com
ADMIN_EMAIL=admin@worldtv.com

