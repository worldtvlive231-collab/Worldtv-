# World TV - Environment Configuration

# Server
NODE_ENV=production
PORT=8080
PUBLIC_BASE_URL=https://myworldtvlive.com

# Database
DATABASE_URL=sqlite:///app/data/worldtv.sqlite

# Redis (for caching)
REDIS_URL=redis://localhost:6379

# RapidAPI Football
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=api-football-v1.p.rapidapi.com

# OpenAI (for AI live-chat replies and image generation)
OPENAI_API_KEY=sk-your_openai_key_here
# Model used for automatic live-chat support replies.
OPENAI_MODEL=gpt-5-mini

# Cloudinary (for image storage)
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=https://api.cloudinary.com/v1_1/your_cloud_name

# Optional: Payment Integration
PAYSTACK_PUBLIC_KEY=pk_live_your_key
PAYSTACK_SECRET_KEY=sk_live_your_key
PAYSTACK_HOSTED_PAGE_URL=https://paystack.shop/pay/x4sqejilmz
PAYSTACK_HOSTED_PAGE_AMOUNT_GHS=270

# Pocketi Ghana checkout. These defaults match the WORLD TV annual product.
POCKETI_API_BASE=https://api-shop.pocketi.app
POCKETI_SHOP_SLUG=worldtv
POCKETI_MERCHANT_ID=21407
POCKETI_PRODUCT_ID=783107ff-addf-4d65-91fa-ad3d1f21b0fb
POCKETI_PRODUCT_PRICE_GHS=250
POCKETI_PAYMENT_POLL_MS=30000

# Stripe hosted Checkout for the USD subscription payment option.
# Prefer a restricted live key with Checkout Sessions write access.
STRIPE_SECRET_KEY=rk_live_your_restricted_key
# Signing secret for https://myworldtvlive.com/api/payment/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Transactional email + automatic sales recovery
# Create a verified sender/domain with Resend and keep the API key in Railway variables.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="WORLD TV <support@myworldtvlive.com>"
SALES_RECOVERY_SIGNING_SECRET=replace_with_a_long_random_secret
SALES_RECOVERY_INTERVAL_MINUTES=30
EMAIL_QUEUE_INTERVAL_SECONDS=60
EMAIL_QUEUE_BATCH_SIZE=15

# Referral + campaign attribution
# Paid referrals earn this many bonus subscription days. Defaults to 30 if omitted.
REFERRAL_REWARD_DAYS=30

# Application Settings
APP_NAME=World TV
APP_URL=https://myworldtvlive.com
ADMIN_EMAIL=admin@worldtv.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password
